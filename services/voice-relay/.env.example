# copy to .env (gitignored) and fill in yourself — never commit
DEEPGRAM_API_KEY=
# optional: without these the relay runs in "no-DB" mode (conversation only)
SUPABASE_URL=https://ycyrtlzympxzlfcocazh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# optional overrides
THINK_PROVIDER=anthropic
THINK_MODEL=claude-sonnet-5
# voice: aura-2-viktoria-de (default) or aura-2-elara-de (calmer)
SPEAK_MODEL=aura-2-viktoria-de
# listen: nova-3 (default) or flux-general-multi (Flux, German hint)
LISTEN_MODEL=nova-3
PORT=8787
# comma-separated pages allowed to open calls (default: this relay's own page)
ALLOWED_ORIGINS=
# also accepted by default: https://<sub>.lovable.app and https://<sub>.lovableproject.com (any Lovable app!)
# set it empty (ALLOWED_ORIGIN_SUFFIXES=) to allow only ALLOWED_ORIGINS once the project URL is fixed
# ALLOWED_ORIGIN_SUFFIXES=.lovable.app,.lovableproject.com
MAX_CONCURRENT_CALLS=3
MAX_LISTEN_SECONDS=120
SILENCE_LIMIT_MS=30000
HOLD_LIMIT_MS=90000
# bind address: keep 127.0.0.1 locally; 0.0.0.0 inside Docker/Render/Fly
HOST=
