{
  "mcpServers": {
    "n8n": {
      "type": "http",
      "url": "https://arahmandeaxo.app.n8n.cloud/mcp-server/http",
      "headers": {
        "Authorization": "Bearer ${N8N_MCP_TOKEN}"
      }
    },
    "n8n-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "https://arahmandeaxo.app.n8n.cloud",
        "N8N_API_KEY": "${N8N_API_KEY:-}",
        "N8N_MCP_ACCESS_TOKEN": "${N8N_MCP_TOKEN:-}"
      }
    },
    "lovable": {
      "type": "http",
      "url": "https://mcp.lovable.dev"
    }
  }
}
